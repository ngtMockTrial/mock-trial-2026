        <mxCell id="R3" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;R3　反対事情又は限界&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;共用自転車を別人が使用&lt;br&gt;映像も木村と特定できない&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.4-5、弁護主張 p.34&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#af554c;strokeWidth=2;fontColor=#662e29;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="counter" sourceReference="甲1 p.4-5、弁護主張 p.34">
