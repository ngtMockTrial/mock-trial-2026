        <mxCell id="subtitle" value="中心は眼鏡。清掃・自転車・映像・動機の意味と限界を重ねる。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=19;fontColor=#17283b;" vertex="1" parent="1">
