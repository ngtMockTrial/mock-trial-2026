        <mxCell id="Q" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;Q　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:18px;line-height:1.32;font-weight:bold;&quot;&gt;最終的な検討対象&lt;br&gt;木村の犯人性に合理的な疑いが残るか&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;立証責任は検察官。詳細は既存資料01&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="立証責任は検察官。詳細は既存資料01">
          <mxGeometry x="450" y="115" width="700" height="115" as="geometry" />
