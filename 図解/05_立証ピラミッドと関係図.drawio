        <mxCell id="R1" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;R1　反対事情又は限界&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;昼に眼鏡を落とし&lt;br&gt;別人の犯行時に血が付いたとの説明&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;弁護冒頭陳述 p.34&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#af554c;strokeWidth=2;fontColor=#662e29;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="counter" sourceReference="弁護冒頭陳述 p.34">
          <mxGeometry x="45" y="385" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;R2　反対事情又は限界&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;大滝が清掃で&lt;br&gt;眼鏡を見落とした可能性&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;準備：甲3 p.21-22&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#af554c;strokeWidth=2;fontColor=#662e29;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="counter" sourceReference="準備：甲3 p.21-22">
