        <mxCell id="F2" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;F2　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;眼鏡に岸井由来の血液が付着&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.4&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 p.4">
