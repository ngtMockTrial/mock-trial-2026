        <mxCell id="L04" value="反対　推論の強さを検討" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#ad5148;fontColor=#ad5148;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=tee;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="C" target="I3">
