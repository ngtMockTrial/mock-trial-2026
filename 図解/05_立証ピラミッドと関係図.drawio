              <mxPoint x="600" y="715" />
            </Array>
            <mxPoint x="0.0" y="-15.0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="L02" value="推認　事実から推認" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#4e805a;fontColor=#4e805a;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="F" target="I1">
