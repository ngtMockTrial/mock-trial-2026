          <mxGeometry x="35" y="77" width="1530" height="38" as="geometry" />
        </mxCell>
        <mxCell id="I" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;I　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:21px;line-height:1.32;font-weight:bold;&quot;&gt;条件付きの推認&lt;br&gt;昼からB地点に眼鏡が残っていたとの説明は採りにくい&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;見落とし・移動の可能性も含めて判断&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="見落とし・移動の可能性も含めて判断">
          <mxGeometry x="410" y="115" width="780" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P1" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;P1　主張又は要確認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;18時頃の清掃で&lt;br&gt;眼鏡を見なかったとの証言&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;準備：甲3 p.22&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6e3;strokeColor=#b17b1a;strokeWidth=2;fontColor=#49350c;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;dashed=1;" vertex="1" parent="1" classification="pending" sourceReference="準備：甲3 p.22">
          <mxGeometry x="45" y="390" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="P2" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;P2　主張又は要確認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;B地点にあれば&lt;br&gt;発見できたといえる観察条件&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;実演で具体的に確認する&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6e3;strokeColor=#b17b1a;strokeWidth=2;fontColor=#49350c;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;dashed=1;" vertex="1" parent="1" classification="pending" sourceReference="実演で具体的に確認する">
          <mxGeometry x="585" y="390" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="R" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;R　反対事情又は限界&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;見落としの可能性&lt;br&gt;日没後・急ぎ・車や物の陰&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.6、準備：甲3 p.21-22&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#af554c;strokeWidth=2;fontColor=#662e29;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="counter" sourceReference="甲1 p.6、準備：甲3 p.21-22">
