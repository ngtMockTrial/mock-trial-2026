        <mxCell id="P" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;P　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:18px;line-height:1.32;font-weight:bold;&quot;&gt;要証事実&lt;br&gt;岸井を刺した人物は木村である&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;検察側が立証する中心争点&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="検察側が立証する中心争点">
          <mxGeometry x="520" y="120" width="560" height="110" as="geometry" />
        </mxCell>
        <mxCell id="I1" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;I1　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;犯行時の現場との接点&lt;br&gt;眼鏡の所在・血液と落下時刻を評価&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;詳細 図04-05&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="詳細 図04-05">
