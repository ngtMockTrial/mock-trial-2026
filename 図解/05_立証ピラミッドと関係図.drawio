        <mxCell id="L02" value="認定　医学的死因を認定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#4577a5;fontColor=#4577a5;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="E1B" target="B">
