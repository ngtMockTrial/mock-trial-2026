  <diagram id="diagram-10" name="10 刺創から死亡に至る因果関係">
    <mxGraphModel dx="1600" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="10  刺創から死亡に至る因果関係" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=31;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="1530" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="傷・死因・死亡をつなぐ。行為者が木村であることは図03で別に立証する。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=19;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="77" width="1530" height="38" as="geometry" />
        </mxCell>
        <mxCell id="D" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;D　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:18px;line-height:1.32;font-weight:bold;&quot;&gt;要証事実&lt;br&gt;岸井の刺創が死亡を引き起こした&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 教材p.3の検案・死亡確認が根拠&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="甲1 教材p.3の検案・死亡確認が根拠">
          <mxGeometry x="480" y="115" width="640" height="115" as="geometry" />
        </mxCell>
        <mxCell id="W" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;W　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;胸腹部・腕・右大腿部に&lt;br&gt;複数の刺創があった&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 p.3">
          <mxGeometry x="45" y="405" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="B" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;B　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;これらの傷による&lt;br&gt;出血性ショックが死因&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 p.3">
          <mxGeometry x="585" y="405" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="T" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;T　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;搬送先で同日21時55分&lt;br&gt;岸井の死亡を確認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 p.3">
          <mxGeometry x="1125" y="405" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="E1A" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;E1A　証拠資料&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;検案結果の創傷の記載&lt;br&gt;左胸2・右上腹1・両腕複数・右大腿1&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3 第2の2①&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#7f8a96;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="evidence" sourceReference="甲1 p.3 第2の2①">
          <mxGeometry x="45" y="800" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="E1B" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;E1B　証拠資料&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;検案結果の死因の記載&lt;br&gt;上記の傷による出血性ショック&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3 第2の2③&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#7f8a96;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="evidence" sourceReference="甲1 p.3 第2の2③">
          <mxGeometry x="585" y="800" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="E1C" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;E1C　証拠資料&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;搬送と死亡確認の記載&lt;br&gt;五哲大学病院で21時55分&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.3 第2の1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#7f8a96;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="evidence" sourceReference="甲1 p.3 第2の1">
          <mxGeometry x="1125" y="800" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="L01" value="認定　創傷の存在を認定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#4577a5;fontColor=#4577a5;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="E1A" target="W">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0.0" y="-18.0" as="offset" />
          </mxGeometry>
