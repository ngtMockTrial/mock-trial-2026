        <mxCell id="K" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;K　人物又は場所&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;木村忠太&lt;br&gt;眼鏡の持ち主・自転車の通常利用者&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.4-5、乙1 p.25&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2eff8;strokeColor=#806b9c;strokeWidth=2;fontColor=#342947;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="person" sourceReference="甲1 p.4-5、乙1 p.25">
