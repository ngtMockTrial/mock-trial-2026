        <mxCell id="L05" value="推認　組み合わせて判断" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#4e805a;fontColor=#4e805a;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="I1" target="Y">
