<mxfile host="app.diagrams.net" type="device" pages="15">
  <diagram id="diagram-01" name="01 図の読み方と推論の段階">
    <mxGraphModel dx="1600" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="01  図の読み方と推論の段階" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=31;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="1530" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="下の証拠から上の要証事実へ読む。各矢印の説明を確認する。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=19;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="77" width="1530" height="38" as="geometry" />
        </mxCell>
        <mxCell id="Y" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;Y　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:21px;line-height:1.32;font-weight:bold;&quot;&gt;要証事実の例&lt;br&gt;木村が岸井を刺したという犯人性&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;検察側が証明する主張の例：起訴状 教材p.1&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="検察側が証明する主張の例：起訴状 教材p.1">
          <mxGeometry x="480" y="125" width="640" height="140" as="geometry" />
        </mxCell>
        <mxCell id="I1" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;I1　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;眼鏡の所有・血液・発見場所から&lt;br&gt;現場との接点を評価&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;詳細 図04&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="詳細 図04">
          <mxGeometry x="45" y="405" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="I2" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;I2　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;清掃状況と落下時刻の説明から&lt;br&gt;昼の落下という説明を評価&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;詳細 図05&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="詳細 図05">
          <mxGeometry x="585" y="405" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="I3" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;I3　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;自転車・映像・動機を&lt;br&gt;犯人性の補助事情として評価&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;詳細 図06-08&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="詳細 図06-08">
          <mxGeometry x="1125" y="405" width="430" height="130" as="geometry" />
        </mxCell>
        <mxCell id="E" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;E　証拠資料&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;証拠資料&lt;br&gt;甲1・甲2・乙1など&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;採用の範囲：教材p.2&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f5f7;strokeColor=#7f8a96;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="evidence" sourceReference="採用の範囲：教材p.2">
          <mxGeometry x="35" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="F" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;F　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;間接事実&lt;br&gt;眼鏡の所在や血液の由来&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;証拠が支える範囲を区別&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="証拠が支える範囲を区別">
          <mxGeometry x="435" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="P" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;P　主張又は要確認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;実演で要確認&lt;br&gt;甲3・乙2の準備内容&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;調書自体は採否留保&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff6e3;strokeColor=#b17b1a;strokeWidth=2;fontColor=#49350c;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;dashed=1;" vertex="1" parent="1" classification="pending" sourceReference="調書自体は採否留保">
          <mxGeometry x="835" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="C" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;C　反対事情又は限界&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;反対事情・別の説明&lt;br&gt;見落としや第三者の使用&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;採用済み事実と主張を区別&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0ef;strokeColor=#af554c;strokeWidth=2;fontColor=#662e29;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="counter" sourceReference="採用済み事実と主張を区別">
          <mxGeometry x="1235" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="L01" value="認定　例示：証拠から事実を認定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;jumpStyle=arc;jumpSize=8;html=0;strokeWidth=2;strokeColor=#4577a5;fontColor=#4577a5;fontSize=16;fontFamily=Meiryo;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="E" target="F">
          <mxGeometry relative="1" as="geometry">
