            <mxPoint x="0.0" y="-18.0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="notes" value="岸井と本所の実際の交際をLINEだけで確定せず、木村がどう受け止めていたかを評価する。&#10;10月の復縁要求が、犯行日まで同じ強さで続いたと自動的に決めない。&#10;怒りや未練は犯行そのものの証明ではなく、物的接点を検討する補助事情。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=16;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="1016" width="1530" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
