  <diagram id="diagram-02" name="02 事件全体の立証ピラミッド">
    <mxGraphModel dx="1600" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02  事件全体の立証ピラミッド" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=31;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="25" width="1530" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="要証事実を犯人性・殺意・死亡との因果関係に分ける。" style="text;html=0;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Meiryo;fontSize=19;fontColor=#17283b;" vertex="1" parent="1">
          <mxGeometry x="35" y="77" width="1530" height="38" as="geometry" />
        </mxCell>
        <mxCell id="Y" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;Y　要証事実又は検討対象&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:21px;line-height:1.32;font-weight:bold;&quot;&gt;木村による殺人という検察側の主張&lt;br&gt;犯人性・殺意・行為と死亡との関係を立証する&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;起訴状 教材p.1　証明済みの意味ではない&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#203f59;strokeColor=#203f59;strokeWidth=2;fontColor=#ffffff;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="goal" sourceReference="起訴状 教材p.1　証明済みの意味ではない">
          <mxGeometry x="430" y="120" width="740" height="120" as="geometry" />
        </mxCell>
        <mxCell id="P" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;P　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;犯人性&lt;br&gt;岸井を刺したのが木村である&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;主争点。詳細 図03&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="主争点。詳細 図03">
          <mxGeometry x="45" y="385" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="M" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;M　検察側の推認&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;殺意&lt;br&gt;死亡の危険を認識して刺した&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;推認の根拠と限界は図11&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#edf7ef;strokeColor=#4e805a;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="infer" sourceReference="推認の根拠と限界は図11">
          <mxGeometry x="585" y="385" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="D" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;D　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;因果関係&lt;br&gt;刺創による出血性ショックで死亡&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;傷と死因の関係は図10&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="傷と死因の関係は図10">
          <mxGeometry x="1125" y="385" width="430" height="145" as="geometry" />
        </mxCell>
        <mxCell id="G" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;G　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;現場に木村の眼鏡&lt;br&gt;岸井の血液が付着&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 教材p.3-4・7／図04&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 教材p.3-4・7／図04">
          <mxGeometry x="35" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="B" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;B　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;共用自転車の血液&lt;br&gt;映像・清掃の検討&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.4-6／図05-07&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲1 p.4-6／図05-07">
          <mxGeometry x="435" y="780" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="L" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;L　認定する事実&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;岸井への怒り&lt;br&gt;駐車場の認識&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲2 p.16-19／図08&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#4577a5;strokeWidth=2;fontColor=#17283b;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="fact" sourceReference="甲2 p.16-19／図08">
