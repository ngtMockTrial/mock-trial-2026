        <mxCell id="S" value="&lt;div style=&quot;font-family:Meiryo;font-size:14px;&quot;&gt;S　人物又は場所&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:20px;line-height:1.32;&quot;&gt;岸井新之助&lt;br&gt;眼鏡と自転車に血液が付着&lt;/div&gt;&lt;div style=&quot;font-family:Meiryo;font-size:13.5px;margin-top:4px;&quot;&gt;甲1 p.4-5&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2eff8;strokeColor=#806b9c;strokeWidth=2;fontColor=#342947;fontFamily=Meiryo;align=left;verticalAlign=middle;spacing=14;overflow=hidden;" vertex="1" parent="1" classification="person" sourceReference="甲1 p.4-5">
